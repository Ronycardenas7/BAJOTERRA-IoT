# Fuerza finales de línea LF en archivos que se ejecutan o se montan dentro de contenedores Linux.
# En Windows, Git puede convertirlos a CRLF y eso rompe scripts, Dockerfile y configuraciones.
Dockerfile text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
pnpm-lock.yaml text eol=lf
# Los archivos .bat de Windows deben tener finales de linea CRLF.
*.bat text eol=crlf
