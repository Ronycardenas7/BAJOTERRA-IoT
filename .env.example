# ============================================================================
# .env.example — plantilla de configuración. Valores FICTICIOS.
# Copie este archivo como ".env" y cambie la contraseña. El archivo ".env" NO se sube a Git.
#   Linux / macOS:   cp .env.example .env
#   Windows (CMD):   copy .env.example .env
# ============================================================================

# Usuario del broker MQTT (lo usan el backend y el simulador).
MQTT_USER=bajoterra
# Contraseña del broker MQTT. CÁMBIELA. Evite el signo $ (Docker Compose lo interpreta como variable).
MQTT_PASSWORD=cambia-esta-clave-local
# Prefijo de todos los temas MQTT (ver docs/mqtt-topics.md).
MQTT_PREFIJO=bajoterra/01

# Nivel de detalle de los logs del backend: DEBUG, INFO, WARNING o ERROR.
NIVEL_LOG=INFO

# Cada cuántos segundos publica el simulador (más alto = menos CPU).
SIM_INTERVALO_S=5
# Semilla del simulador: vacía = datos aleatorios; un número = los mismos datos cada vez (útil para depurar).
SIM_SEMILLA=

# Puertos que se abren EN ESTE EQUIPO (solo accesibles desde 127.0.0.1). Cámbielos si ya están ocupados.
# Puerto del broker MQTT (útil para probar con mosquitto_pub / mosquitto_sub).
MQTT_PUERTO_HOST=1883
# Puerto de la API del backend.
BACKEND_PUERTO_HOST=5000
# Puerto de la web.
WEB_PUERTO_HOST=8080
